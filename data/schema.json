{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quotify.dev/schemas/dataset.json",
  "title": "Quotify 数据集",
  "description": "数据源文件（如 data/data.json）与上游数据集必须满足的结构。tests/data.test.ts 会按等价规则校验仓库内的示例数据；本文件供外部工具（编辑器、CI 插件）复用。",
  "type": "object",
  "required": ["version", "quotes"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "number",
      "description": "数据集版本号，聚合时取各来源的最大值。"
    },
    "updated_at": {
      "type": "string",
      "description": "最后更新时间（ISO 8601）。建议每次内容变更时同步更新。"
    },
    "quotes": {
      "type": "array",
      "items": { "$ref": "#/definitions/quote" }
    }
  },
  "definitions": {
    "quote": {
      "type": "object",
      "required": ["id", "content"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "全局唯一标识；多来源合并时按它去重。"
        },
        "content": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
